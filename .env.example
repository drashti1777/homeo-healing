# MongoDB connection string
MONGODB_URI=mongodb://127.0.0.1:27017/homeo-healing
# At least 32 random characters. Generate with: openssl rand -base64 48
AUTH_SECRET=
# Public URL of the site (used for canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Where uploaded images are stored
UPLOAD_DIR=./uploads
# Used only by `npm run seed` to create the first admin user
ADMIN_EMAIL=
ADMIN_PASSWORD=
